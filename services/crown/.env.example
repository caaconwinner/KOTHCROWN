# Copy to .env (never commit it). Load with: node --env-file=.env ...
RPC_URL=https://api.devnet.solana.com
MINT=
# Crank / setup only: path to the keypair that pays transaction fees.
KEYPAIR=~/.config/solana/devnet.json
# Setup only.
DEV_WALLET=
# Indexer / API.
DB_PATH=./crown.sqlite
PORT=8787
POLL_MS=5000
# Crank.
SYNC_INTERVAL_S=60
PRIORITY_MICROLAMPORTS=0
BUYBACK_MIN_LAMPORTS=50000000
BUYBACK_SLIPPAGE_BPS=200
# Health (/api/health answers 503 when something needs a human; point an uptime monitor at it).
CRANK_STALE_S=300
# The crank's public address (not its keypair), to warn when it runs low on SOL.
CRANK_PUBKEY=
CRANK_MIN_LAMPORTS=50000000
