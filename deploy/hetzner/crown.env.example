# /etc/crown/crown.env on the server (owner root, group crown, mode 640).
# Never commit the real file.

# Paid RPC (Helius, Triton, QuickNode...). Mainnet only with the owner's go.
RPC_URL=https://YOUR-PAID-RPC
MINT=
POLL_MS=5000

# Crank
SYNC_INTERVAL_S=60
PRIORITY_MICROLAMPORTS=10000
BUYBACK_MIN_LAMPORTS=50000000
BUYBACK_SLIPPAGE_BPS=200

# Health (/api/health answers 503 when something needs a human)
CRANK_STALE_S=300
# The crank's public address, to warn when it runs low on SOL
CRANK_PUBKEY=
CRANK_MIN_LAMPORTS=50000000
