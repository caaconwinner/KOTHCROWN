# /etc/crown/crown.env on the server (owner root, group crown, mode 640).
# Never commit the real file.

# Helius mainnet RPC (server key). Mainnet only with the owner's go.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR-SERVER-KEY
# The coin, printed by `pnpm --filter @koth-crown/services launch`.
MINT=
# Price of the first claim, lamports (0.2 SOL, the owner's choice; never below the 0.2 SOL minimum).
OPENING_PRICE_LAMPORTS=200000000
# Collect pump.fun fees and run the burn this often.
FEE_INTERVAL_S=60
# /api/health answers 503 when fees have not been collected for this long,
# or when the game wallet holds less than this above everything it owes.
CRANK_STALE_S=300
GAME_MIN_SPARE_LAMPORTS=20000000
