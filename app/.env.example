# Copy to .env.local (never commit it).
# Where the API is. Leave it empty and the site shows its pre-launch page.
#   http://localhost:8787   the indexer from services/crown (or its public address)
#   /                       the API built into this site (src/app/api), which
#                           then needs RPC_URL and MINT below
NEXT_PUBLIC_API_URL=http://localhost:8787
# "devnet" shows a test-mode banner. Leave unset on mainnet.
NEXT_PUBLIC_CLUSTER=devnet
# Built-in API only (server side, not sent to the browser):
RPC_URL=https://api.devnet.solana.com
MINT=
# Optional, built-in API only: a JSON keypair that pays for the fee sync when
# NEXT_PUBLIC_LAZY_CRANK=1. Keep very little SOL in it. Never commit it.
CRANK_KEYPAIR=
NEXT_PUBLIC_LAZY_CRANK=
# Public address of the site, for link previews.
NEXT_PUBLIC_SITE_URL=https://takethecrown.fun
# RPC the wallet sends the take-crown transaction through.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional links for the top bar.
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TELEGRAM_URL=
