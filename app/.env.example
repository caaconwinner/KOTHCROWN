# Copy to .env.local (never commit it).
# The indexer/API from services/crown. Leave it empty and the site shows its
# pre-launch page instead of the throne.
NEXT_PUBLIC_API_URL=http://localhost:8787
# Public address of the site, for link previews.
NEXT_PUBLIC_SITE_URL=https://takethecrown.fun
# RPC the wallet sends the take-crown transaction through.
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
# Optional links for the top bar.
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_TELEGRAM_URL=
